# Copy to .env before running docker compose. .env is git-ignored.

# Application
SERVER_PORT=4000
APP_HOST_PORT=4000

# Database
DB_NAME=cms
DB_USER_NAME=cms
# Development value. In Azure this comes from Key Vault.
DB_PASSWORD=localdev
DB_HOST_PORT=5432
# Appended to the JDBC URL, for example ?sslmode=require against Azure.
DB_OPTIONS=
