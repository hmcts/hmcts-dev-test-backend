# Local development only. Copy to .env, which is gitignored:
#   cp .env.example .env
#
# Throwaway values. Real environments get the password from Key Vault.

SERVER_PORT=4000

DB_NAME=devtest
DB_USER_NAME=devtest
DB_PASSWORD=change-me-locally

# Only needed if 4000/5432 are already taken on your machine.
APP_HOST_PORT=4000
DB_HOST_PORT=5432
